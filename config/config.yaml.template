# 5-HT2A pipeline — configuración local (NO versionar valores privados).
# Copiar desde config/config.yaml.template y ajustar rutas.

seed: 42
device: cuda  # cuda | cpu

paths:
  repo_root: "."
  curacion_dir: "curacion"
  modelo_pki_dir: "modelo_pki"
  generacion_dir: "generacion"
  filtro_dir: "filtro"
  # Destino de modelos descargados desde Zenodo (reemplaza el symlink cross-stage).
  models_dir: "modelos"
  prior_file: "modelos/reinvent.prior"

data:
  tl_smiles: "data/tl_smiles.smi"
  pki_curated: "data/pki/pki_curated.csv"
  pki_split: "data/pki/split_indices.csv"
  pki_raw_gpcrdb: "data/raw/GPCRdb_pvalue.xlsx"
  pki_raw_chembl: "data/raw/df_chembl.csv"

curacion:
  # Entrada: datos crudos (data/raw). Salida: data/pki/pki_curated.csv (regla curacion).

modelo_pki:
  # Productivo: single model seed_2 (mejor test: RMSE 0.747, R2 0.669).
  # El ensemble 1-5 queda como experimento no publicado; el scorer acepta ambos.
  seeds: [2]
  max_epochs: 50
  # Smoke test rápido (no toca checkpoints productivos):
  smoke_limit: 200
  smoke_epochs: 1

generacion:
  batch_size: 256
  s1_steps: 500
  tl_epochs: 20
  s2_steps: 1000
  inception_smiles: ""  # opcional

filtro:
  score_cutoff: null  # ej. 0.5 para filtrar Score REINVENT
  max_mols: null
  max_stereoisomers: 8
  sa_score_cutoff: 4.5
  smiles_col: "SMILES"

zenodo:
  # Record publicado con los 3 archivos productivos (single seed_2 + stage2).
  # DOI: https://doi.org/10.5281/zenodo.23249654 — licencia CC-BY-4.0.
  # El ID 15460715 corresponde al foundation model CheMeleon (externo, solo cita).
  record: "23249654"
  files_checksum: "scripts/checksums.txt"
