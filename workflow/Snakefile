"""
Snakemake workflow: 5-HT2A curacion -> modelo_pki -> generacion -> filtro.

Flujo (entrenamiento -> generacion -> filtro):
    1. curacion:   curación de pKi (GPCRdb + ChEMBL) -> results/curacion/pki_curated.csv
    2. modelo_pki: fine-tune del modelo CheMeleon -> results/modelo_pki/checkpoints/...
    3. generacion: REINVENT4 staged learning (S1 -> TL -> S2) -> results/generacion/stage2_1.csv
    4. filtro:     filtros químicos + export pharmit-ready -> results/filtro/pharmit_ready.*

Docking queda AFUERA (repo aparte `docking_5ht2a`). El output final de este
workflow (filtro) es el input manual de docking/Pharmit.

Uso:
    cp config/config.yaml.template config/config.yaml  # y editar rutas/record Zenodo
    snakemake --use-conda --cores 8                     # pipeline completo
    snakemake --use-conda --cores 4 --config device=cpu generacion__s1_smoke
    snakemake --dry-run -n                             # solo grafo

Outputs:
    results/filtro/pharmit_ready.csv + .smi.gz
"""

configfile: "config/config.yaml"

SEEDS = config["modelo_pki"]["seeds"]

rule all:
    input:
        "results/filtro/pharmit_ready.csv",
        "results/filtro/pharmit_ready.smi.gz",

include: "rules/curacion.smk"
include: "rules/modelo_pki.smk"
include: "rules/generacion.smk"
include: "rules/filtro.smk"
